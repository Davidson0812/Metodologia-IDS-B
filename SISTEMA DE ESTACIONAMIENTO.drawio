          <mxGeometry height="105" width="340" x="40" y="670" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-14" parent="JKg73n8mvG7aNlOGgdbT-13" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="-¿La matrícula esta registrada?&lt;div&gt;-¿Hay espacios disponibles?&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-15" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="3. Identificar los procesos" vertex="1">
          <mxGeometry height="260" width="340" x="40" y="383" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-16" parent="JKg73n8mvG7aNlOGgdbT-15" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;-Solicitar al conductor la matrícula&lt;/div&gt;-Leer la matrícula del vehículo&lt;div&gt;-Buscar la matrícula en la base de datos&lt;/div&gt;&lt;div&gt;-Consultar la cantidad de espacios disponibles&lt;/div&gt;&lt;div&gt;-Restar 1 a la cantidad de espacios&amp;nbsp;&lt;/div&gt;&lt;div&gt;-Registrar el vehículo dentro del estacionamiento&lt;/div&gt;&lt;div&gt;&lt;div&gt;-Generar comprobante de acceso (Ticket)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-Entregar comprobante de acceso&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-Restar 1 a los espacios disponibles&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-Registrar el vehículo en una lista de los vehículos del estacionamiento.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;-Levantar la barrera de entrada&lt;/div&gt;&lt;div&gt;-Dejar pasar al vehículo&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-Cuando pase el vehículo bajar la barrera de entrada&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-21" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="6. Construir el algoritmo&amp;nbsp;" vertex="1">
          <mxGeometry height="370" width="340" x="40" y="930" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-22" parent="JKg73n8mvG7aNlOGgdbT-21" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. Inicio&lt;/span&gt;&lt;/div&gt;2. Solicitar al conductor su matrícula&lt;div&gt;3. Leer la matrícula del vehículo&lt;/div&gt;&lt;div&gt;4. Buscar la matrícula en la base de datos&amp;nbsp;&lt;/div&gt;&lt;div&gt;5. Si la matrícula no está registrada mostrar el mensaje de &quot;Matrícula no registrada&quot; y el proceso termina para el vehículo&lt;/div&gt;&lt;div&gt;6. Si la matrícula si está registrada, consultar los espacios disponibles&lt;/div&gt;&lt;div&gt;7. Evaluar si hay espacios disponibles &amp;gt;0&lt;div&gt;8. Si no hay espacios disponibles, mostrar &quot;Estacionamiento lleno, sin espacios disponibles&quot;&lt;/div&gt;&lt;div&gt;9. Si hay espacios disponibles, mostrar&amp;nbsp; la cantidad&lt;/div&gt;&lt;div&gt;10. Mostrar &quot;Acceso autorizado&quot;&lt;/div&gt;&lt;div&gt;11. Generar comprobante de acceso (Ticket)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;12. Entregar comprobante de acceso&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;13. Restar 1 a los espacios disponibles&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;14. Registrar el vehículo en una lista de los vehículos del estacionamiento.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;15. Levantar la barrera de entrada&lt;/div&gt;&lt;div&gt;16. Dejar pasar al vehículo&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;17. Cuando pase el vehículo bajar la barrera de entrada&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;18. Fin&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="340" y="30" as="geometry" />
        </mxCell>
