          <mxGeometry height="105" width="340" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="JKg73n8mvG7aNlOGgdbT-12" parent="JKg73n8mvG7aNlOGgdbT-11" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="-&quot;Matrícula no registrada&quot;&lt;div&gt;-&quot;Acceso autorizado&quot;&lt;/div&gt;&lt;div&gt;-&quot;Estacionamiento lleno, sin espacios disponibles&quot;&lt;/div&gt;&lt;div&gt;-Mostrar los espacios disponibles&lt;/div&gt;" vertex="1">
